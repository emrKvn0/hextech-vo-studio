[
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Never one..."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "...without the other."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "You overstep."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Never one..."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "...without the other."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Never one..."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "...without the other."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Every life..."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "...ends with us."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Tell me again, little Lamb, which things are mine to take?"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "All things, dear Wolf."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Embracing life means accepting death."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Panic not when life ebbs."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "All sparks kindle new flames."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Depart in peace."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Hush now. Rest."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "You shine brightly."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Drift gently into oblivion."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "How one dies shows how one lived."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Run if you can!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "They struggle! Good!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "They break too easy!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Feet tire fast!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Ready to chase? Too bad!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "This will hurt - lots!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "No more words!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Tear out the throat!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Rip them to bits!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "My claws never dull!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "This one is yours."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Yes!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Lamb calls!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Wolf strikes."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "A careless step..."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "...then teeth!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Life is ours..."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "...to end!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Go easily."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "No! Thrash! Flee!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Time to..."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "...end this."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Mine?"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Ours."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Flee - or stand firm."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Doesn't matter!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Day always turns to..."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "...food!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Those who dread us grant us the most power."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "We are not dreams. We are the waking."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Beauty fades. That is why it is beautiful."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Wolf chases what does not willingly go."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Tomorrow is a hope, never a promise."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Hurry, Lamb. Faster."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "I smell their fear."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "None can hide."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Follow their tracks."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Bits of them stick in my claws!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Fear makes the chase more fun!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "All who run are mine!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Can't wait for them to flee!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "I smell prey!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "How does hunger feel?"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Always there."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "I wonder how they see me."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Ashes on wool."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "What sound do they make?"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Feathers falling on fresh snow."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "None can hide!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Though many try."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "They race from us!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Only to find us sooner."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "The weft and weave of fate guides---"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Words spoil the chase!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "All things linger..."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "...in our shadow."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "They know we'll come."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Yet they are never prepared."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "How long will we be together?"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Forever more."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Peacefully, they go."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Hungry, we follow!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "They laugh."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "And scream!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "And dance."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "And flee!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "And everywhere Lamb went..."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "...Wolf was sure to follow."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "And everywhere Lamb went..."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "...Wolf was sure to follow!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "I see water!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "They are called... tears."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Chasing is the best game in the world... and I always win!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "I'll give you a running start!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Not that it will help."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "It thinks it can beat us!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "This is called... denial."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Choose now - my arrows..."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "...or my teeth?!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "We understand your loneliness, but..."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "...stay away!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Pop the balloon!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "We know your name child. Woven across countless almost-lives."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Rushing to meet us again, I see."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Have we met before?"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "His song sounds good."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "The singer mistakes melody for substance."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Long have we shadowed your deeds."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Turn and face us now!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Trees make a boring chase!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Chase the cat!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Rengar is well-versed in the ways of the hunter."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Now, he's prey!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Come, Sion, let us end this mockery."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Sometimes, death is a blessing."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "There are no wolves like me!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Hold still, Wolf."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Ahh! Don't shoot me!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "What happens if you miss?"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "I don't know."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Words, words, la la la, pew twang pew!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Are you imitating me?"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "I'm hungry, I'm hungry, I'm bored, chase chase chase!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "You get it now!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "The weft and weave of fate guides... um... uh... how did that poem go again?"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "The masks of the Kindred seek you!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Our mark looms over you."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Treasure your final moments."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Eternal twilight calls for you."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Your next treat, dear Wolf."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Fate hunts you today."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "A fine life reaches its conclusion."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Their path is destined to cross ours."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "The hunt begins!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "This one is ready!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Run! Now!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "There you are!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "I hope this one has strong legs!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "I will chase it until it's dead!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "We have your name."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "And your scent!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Your time has come."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Ready or not!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "We know your name!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "We have always known it."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "When you see us..."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "...it's too late!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Shall we, dear Wolf?"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Race you there!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "This next one will be easy."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "And if not?"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "More fun."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "It knows."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Such befalls all who bear our mark."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "All your life has led to this moment."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "All life is temporary."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Well hunted, dear Wolf."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Return to nothing."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "That was a good chase!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Hahahahaha, that was fun!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Fun chase!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "We take our mark!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Only to place it elsewhere."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Our mark is lifted."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Who's next?!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "No match for me!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "None are, dear Wolf."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "We win!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Always, dear Wolf."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Who's next?"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Everyone."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "All things, great and small..."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "...die."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "No match for us!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "Few are, dear Wolf."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "The chase ends!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "More lie ahead, dear Wolf."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "If it draws breath..."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "...it meets us."
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "The weft and weave of fate guides---"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "The hunt is back on!"
  },
  {
    "category": "quotes",
    "speaker": "Kindred",
    "english_quote": "That was meant to be ours."
  },
  {
    "category": "quotes",
